  "structures": [
    {
      "id": "dewanaku",
      "regex": "ではなく[、,][^。！？!?\\n]{1,40}(?:なのです|なんです|のです)|(?:だけ|のみ)(?:ではありません|じゃありません)[。！!]",
      "name": "「〜ではなく、〜なのです」「〜だけではありません」",
      "fix": "言いたいほうだけを言う。前置きの半分を消す。"
    },
    {
      "id": "sore-wa",
      "regex": "(?:ではありません|じゃありません)。\\s*[^。\\n]{1,30}(?:なのです|なんです)。",
      "name": "「それは〜ではありません。〜なのです。」",
      "fix": "答えから言う。ひっくり返す演出がAIっぽさの正体。"
    },
    {
      "id": "triad",
      "regex": "[^、。\\n]{1,15}、[^、。\\n]{1,15}、そして[^、。\\n]{1,20}|[^、。\\n]{1,10}も、?[^、。\\n]{1,10}も、?[^、。\\n]{1,10}も",
      "name": "三つ並べ（「A、B、そしてC」「AもBもCも」）",
      "fix": "本当に大事な1つか2つに減らす。きれいな三つ並べは機械っぽい。"
    },
    {
      "id": "rhetorical",
      "regex": "(?m)^\\s*(?:その結果|結果|答え|理由|ポイント|秘訣|結論)は[？?]\\s*$|(?:なぜでしょうか|どうしてでしょうか|どういうことでしょうか)[？?]",
      "name": "自分で聞いて自分で答える一行（「その結果は？」「なぜでしょうか？」）",
      "fix": "問いを消して、答えをそのまま書く。"
    },
    {
      "id": "question-opener",
      "regex": "(?:と(?:思った|感じた|悩んだ)こと(?:は|って)(?:ありませんか|ないですか)|(?:お悩み|悩み)ではありませんか)",
      "name": "問いかけ導入（「〜と思ったことはありませんか？」）",
      "fix": "具体的な場面から始める。いつ・どこで・何があったか。"
    },
    {
      "id": "concession",
      "regex": "(?:確かに|たしかに)[^。\\n]{2,60}。\\s*(?:しかし|ですが|でも|とはいえ)",
      "name": "「確かに〜。しかし〜」の譲歩",
      "fix": "譲歩を消して、言いたいほうだけ書く。"
    },
    {
      "id": "preamble",
      "regex": "(?:今回は|今日は|本日は)[^。\\n]{0,30}(?:について|を)(?:ご紹介|紹介|解説|お話)(?:します|していきます|したいと思います)|(?:この|今回の|今日の)(?:動画|リール|投稿)では",
      "name": "動画・投稿の前置き（「今回は〜についてご紹介します」）",
      "fix": "前置きを消して、いちばん言いたい一文から始める。"
    },
    {
      "id": "closer",
      "regex": "(?m)いかがでしたか|いかがでしたでしょうか|^\\s*(?:まとめると|総じて|結論として)",
      "name": "締めの決まり文句（「いかがでしたか」「まとめると」）",
